# Atlas Second Brain — stack-wide environment.
# Copy to .env (never commit the filled-in file — it's gitignored).
# Every value below ships EMPTY. Fill in your own; nothing here is a real
# secret, IP, or domain — these are all placeholders.

# ---------------------------------------------------------------- general
# Your base domain. Services are exposed as subdomains of it, e.g.
# nextcloud.${DOMAIN}, firefly.${DOMAIN}. Point real DNS/A-records at your host.
DOMAIN=your-domain.tld
TZ=Etc/UTC

# ---------------------------------------------------------------- authentik (SSO)
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=
# Random 50+ char string, e.g. `openssl rand -base64 48`
AUTHENTIK_SECRET_KEY=
# Optional: bootstrap an initial admin on first boot
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------- odoo (ERP/tasks)
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=
# Used by the Cerebras Pulse cockpit to read/write a specific project's tasks
ODOO_URL=
ODOO_DB=odoo
ODOO_UID=
ODOO_PASSWORD=
ODOO_PROJECT_ID=

# ---------------------------------------------------------------- nextcloud (files)
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=

# ---------------------------------------------------------------- firefly iii (finance)
FIREFLY_DB_NAME=firefly
FIREFLY_DB_USER=firefly
FIREFLY_DB_PASSWORD=
# 32 random chars, e.g. `openssl rand -base64 32 | head -c 32`
FIREFLY_APP_KEY=

# ---------------------------------------------------------------- stalwart mail / evolution
# WhatsApp bridge (Evolution API) key, if you wire that connector
EVOLUTION_APIKEY=

# ---------------------------------------------------------------- second brain
# Ollama host(s) serving nomic-embed-text. Point at your own always-on box;
# add a fallback if you have a second one.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL_FALLBACK=
# Down-weight for bulk code/boilerplate chunks in hybrid recall (0.0-1.0)
BRAIN_CODE_WEIGHT=0.35
# Keep IPs/hostnames/emails in the brain (1) or scrub them too (0)
SCRUB_KEEP_PII=1

# ---------------------------------------------------------------- cerebras pulse
# Path to your existing gate.py policy chokepoint, if you have one bind-mounted
CEREBRAS_MIND_DIR=/opt/app/mind
NTFY_URL=
NTFY_TOPIC=
