# Copy to env.d/cerebras.env on your host (chmod 600). All values below ship
# EMPTY — fill them in yourself (or point your own deploy script at your
# existing secret sources; never commit the filled-in file).
# Evolution (WhatsApp) API key, from your Evolution instance config:
EVOLUTION_APIKEY=
# Odoo RPC used for the root-cause escalation task:
ODOO_URL=
ODOO_DB=
ODOO_UID=
ODOO_PASSWORD=
ODOO_PROJECT_ID=
